---
import Layout from "../layouts/Layout.astro";
import { SITE, SERVICES, PRODUCT_LINES, CLIENTES_CORPORATIVOS } from "../data/site";
---

<Layout title="EVS Tech | Mayorista Autorizado Lenovo en Venezuela">
  <!-- Hero Section -->
  <section class="relative bg-slate-950 text-white overflow-hidden py-16 lg:py-24 border-b border-slate-800">
    <!-- Ambient Glows -->
    <div class="absolute top-0 right-0 -mr-40 -mt-40 w-96 h-96 rounded-full bg-red-600/20 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -ml-40 -mb-40 w-96 h-96 rounded-full bg-cyan-600/15 blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Copy -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-600/10 border border-red-500/30 text-xs font-bold uppercase tracking-wider text-red-400">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            Mayorista Oficial Lenovo desde 2014
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight">
            Potencia Tecnológica y <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-amber-400">Distribución Mayorista</span> en Venezuela
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
            Suministramos a las principales tiendas, integradores y grandes corporaciones del país: portátiles <strong>ThinkPad</strong>, computadoras de escritorio <strong>ThinkCentre</strong> y arquitectura de servidores <strong>ThinkSystem</strong> con disponibilidad local y despacho nacional.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="/contacto"
              class="px-7 py-3.5 rounded-lg text-sm sm:text-base font-bold text-white bg-red-600 hover:bg-red-700 transition-all shadow-lg shadow-red-600/25 flex items-center gap-2"
            >
              <span>Solicitar Cotización</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
            <a
              href="/productos"
              class="px-7 py-3.5 rounded-lg text-sm sm:text-base font-bold text-slate-200 bg-slate-800/80 hover:bg-slate-700 border border-slate-700 transition-colors"
            >
              Ver Catálogo de Equipos
            </a>
          </div>

          <!-- Quick Stats / Credentials -->
          <div class="grid grid-cols-3 gap-4 pt-6 border-t border-slate-800/80">
            <div>
              <div class="text-2xl sm:text-3xl font-black text-white">+10 Años</div>
              <div class="text-xs text-slate-400 font-medium">Trayectoria en TI</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-red-400">Canal Directo</div>
              <div class="text-xs text-slate-400 font-medium">Mayorista Lenovo</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-cyan-400">Nacional</div>
              <div class="text-xs text-slate-400 font-medium">Cobertura y Despacho</div>
            </div>
          </div>
        </div>

        <!-- Hero Visual Carousel Tabs -->
        <div class="lg:col-span-5">
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-2xl relative overflow-hidden group">
            <div class="aspect-[4/3] rounded-xl overflow-hidden bg-slate-950 relative">
              <img
                id="hero-slider-img"
                src="/images/images/slider/slider149.jpg"
                alt="Infraestructura Lenovo ThinkSystem Servers"
                class="w-full h-full object-cover transition-opacity duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <span id="hero-slider-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-red-600 text-white inline-block mb-1">
                  Data Center
                </span>
                <h3 id="hero-slider-title" class="text-lg font-bold">Servidores ThinkSystem & Storage</h3>
                <p id="hero-slider-desc" class="text-xs text-slate-300">Infraestructura crítica y continuidad para empresas.</p>
              </div>
            </div>

            <!-- Tab Switchers -->
            <div class="grid grid-cols-3 gap-2 mt-3 text-center">
              <button
                type="button"
                data-slide="0"
                class="hero-tab-btn py-2 px-1 text-xs font-bold rounded-lg bg-red-600 text-white transition-all"
              >
                Servers
              </button>
              <button
                type="button"
                data-slide="1"
                class="hero-tab-btn py-2 px-1 text-xs font-bold rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all"
              >
                Desktops
              </button>
              <button
                type="button"
                data-slide="2"
                class="hero-tab-btn py-2 px-1 text-xs font-bold rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all"
              >
                Laptops
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Triad of Value (Pillars from original site) -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1: Socio Comercial -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-8 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-xl bg-red-100 flex items-center justify-center border border-red-200 group-hover:scale-105 transition-transform">
              <img src="/images/img/index/home_icon2.jpg" alt="Socio Comercial" class="w-10 h-10 object-contain rounded" />
            </div>
            <h3 class="text-xl font-black text-slate-900">Conviértete en Socio Comercial</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Si eres distribuidor, tienda de tecnología o integrador de sistemas, inscríbete en nuestra base de datos enviando los datos de tu compañía a <a href={`mailto:${SITE.email}`} class="text-red-600 font-bold hover:underline">{SITE.email}</a>.
            </p>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-200/60">
            <a href="/contacto" class="text-sm font-bold text-red-600 hover:text-red-700 flex items-center gap-1.5">
              Afiliar mi empresa <span>→</span>
            </a>
          </div>
        </div>

        <!-- Card 2: Precios Competitivos -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-8 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-xl bg-cyan-100 flex items-center justify-center border border-cyan-200 group-hover:scale-105 transition-transform">
              <img src="/images/img/index/home_icon3.jpg" alt="Precios Competitivos" class="w-10 h-10 object-contain rounded" />
            </div>
            <h3 class="text-xl font-black text-slate-900">Precios Competitivos por Volumen</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Accede a nuestro boletín con ofertas exclusivas para distribuidores y tramitación de casos especiales de precios para proyectos corporativos y licitaciones de gran escala.
            </p>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-200/60">
            <a href="/servicios#logistica-importacion" class="text-sm font-bold text-cyan-600 hover:text-cyan-700 flex items-center gap-1.5">
              Conocer beneficios B2B <span>→</span>
            </a>
          </div>
        </div>

        <!-- Card 3: Solicitud de Cotización -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-8 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-xl bg-amber-100 flex items-center justify-center border border-amber-200 group-hover:scale-105 transition-transform">
              <img src="/images/img/index/home_icon1.jpg" alt="Solicitud de Cotización" class="w-10 h-10 object-contain rounded" />
            </div>
            <h3 class="text-xl font-black text-slate-900">Solicitud de Cotización Ágil</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Indícanos los requerimientos técnicos de tu proyecto, cantidad estimada y ubicación. Nuestro equipo comercial coordinará la atención con el distribuidor afiliado más cercano a ti.
            </p>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-200/60">
            <a href="/contacto" class="text-sm font-bold text-amber-600 hover:text-amber-700 flex items-center gap-1.5">
              Solicitar ahora <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Categories Section -->
  <section class="py-20 bg-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold text-red-600 uppercase tracking-widest bg-red-50 px-3 py-1 rounded-full border border-red-200">
          Catálogo Mayorista
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-3 tracking-tight">
          Líneas de Equipamiento Corporativo
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2">
          Hardware diseñado para la máxima productividad y confiabilidad en entornos de trabajo intensivo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          PRODUCT_LINES.map((prod) => (
            <div class="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="h-56 overflow-hidden bg-slate-900 relative">
                  <img
                    src={prod.img}
                    alt={prod.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                  <span class="absolute bottom-3 left-4 text-xs font-bold uppercase tracking-wider text-white bg-red-600 px-2.5 py-1 rounded">
                    {prod.brand}
                  </span>
                </div>

                <div class="p-6 space-y-3">
                  <h3 class="text-xl font-black text-slate-900">{prod.title}</h3>
                  <p class="text-xs font-bold text-slate-500 uppercase tracking-wide">{prod.tagline}</p>
                  <p class="text-sm text-slate-600 leading-relaxed">{prod.description}</p>

                  <div class="pt-4 border-t border-slate-100 space-y-2">
                    {prod.series.map((s) => (
                      <div class="text-xs text-slate-700 flex items-start gap-1.5">
                        <span class="text-red-500 font-bold mt-0.5">•</span>
                        <span><strong>{s.name}:</strong> {s.desc}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <div class="p-6 pt-0">
                <a
                  href={`/productos#${prod.id}`}
                  class="w-full inline-flex items-center justify-center py-2.5 px-4 rounded-lg text-sm font-bold text-slate-900 bg-slate-100 hover:bg-red-600 hover:text-white transition-all"
                >
                  Ver Detalles y Modelos
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold text-red-600 uppercase tracking-widest bg-red-50 px-3 py-1 rounded-full border border-red-200">
            Respaldo Integral
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-3 tracking-tight">
            Servicios Especializados de TI
          </h2>
        </div>
        <a href="/servicios" class="text-sm font-bold text-red-600 hover:text-red-700 flex items-center gap-1">
          Ver todos los servicios <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          SERVICES.map((serv) => (
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 hover:border-red-300 hover:bg-white hover:shadow-lg transition-all group">
              <div class="w-14 h-14 rounded-lg bg-white border border-slate-200 p-2 mb-4 group-hover:scale-105 transition-transform flex items-center justify-center">
                <img src={serv.iconImg} alt={serv.title} class="w-full h-full object-contain" />
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{serv.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">{serv.shortDesc}</p>
              <ul class="space-y-1.5 text-xs text-slate-500">
                {serv.features.slice(0, 2).map((f) => (
                  <li class="flex items-start gap-1">
                    <span class="text-red-500 font-bold">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Prestigious Corporate Clients -->
  <section class="py-16 bg-slate-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-red-400">
          Trayectoria Comprobada
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-white mt-2">
          Grandes Empresas Atendidas en Venezuela
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          A través de nuestra red de distribuidores e integradores autorizados.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {
          CLIENTES_CORPORATIVOS.map((c) => (
            <div class="bg-slate-900/90 border border-slate-800 rounded-lg p-3 text-center flex flex-col justify-center items-center hover:border-red-500/50 transition-colors">
              <span class="text-xs font-bold text-white leading-tight">{c.name}</span>
              <span class="text-[10px] text-slate-400 mt-1">{c.category}</span>
            </div>
          ))
        }
      </div>

      <div class="text-center mt-8">
        <a href="/clientes" class="text-xs font-bold text-cyan-400 hover:underline">
          Ver lista completa de clientes y aliados distribuidores →
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Simple slider switcher logic
  const slides = [
    {
      img: "/images/images/slider/slider149.jpg",
      badge: "Data Center",
      title: "Servidores ThinkSystem & Storage",
      desc: "Infraestructura crítica y continuidad para empresas.",
    },
    {
      img: "/images/images/slider/slider529.jpg",
      badge: "Desktops",
      title: "ThinkCentre Towers, SFF & Tiny",
      desc: "Estaciones de trabajo de máximo rendimiento y formato compacto.",
    },
    {
      img: "/images/images/slider/slider513.jpg",
      badge: "Laptops",
      title: "ThinkPad Serie X, T & L",
      desc: "Resistencia militar y seguridad corporativa para profesionales móviles.",
    },
  ];

  let currentIdx = 0;
  const imgEl = document.getElementById("hero-slider-img") as HTMLImageElement;
  const badgeEl = document.getElementById("hero-slider-badge");
  const titleEl = document.getElementById("hero-slider-title");
  const descEl = document.getElementById("hero-slider-desc");
  const tabBtns = document.querySelectorAll(".hero-tab-btn");

  function setSlide(idx: number) {
    currentIdx = idx;
    const s = slides[idx];
    if (imgEl && badgeEl && titleEl && descEl) {
      imgEl.style.opacity = "0";
      setTimeout(() => {
        imgEl.src = s.img;
        badgeEl.textContent = s.badge;
        titleEl.textContent = s.title;
        descEl.textContent = s.desc;
        imgEl.style.opacity = "1";
      }, 150);
    }
    tabBtns.forEach((btn, i) => {
      if (i === idx) {
        btn.classList.remove("bg-slate-800", "text-slate-300");
        btn.classList.add("bg-red-600", "text-white");
      } else {
        btn.classList.remove("bg-red-600", "text-white");
        btn.classList.add("bg-slate-800", "text-slate-300");
      }
    });
  }

  tabBtns.forEach((btn, i) => {
    btn.addEventListener("click", () => setSlide(i));
  });

  // Auto rotate every 5s
  setInterval(() => {
    setSlide((currentIdx + 1) % slides.length);
  }, 5000);
</script>
