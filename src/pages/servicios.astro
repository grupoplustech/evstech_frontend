---
import Layout from "../layouts/Layout.astro";
import { SITE, SERVICES } from "../data/site";
---

<Layout
  title="Servicios Especializados | EVS Tech — Logística de Importación, Data Center y Garantías"
  description="Servicios de tecnología de EVS Tech en Venezuela: logística de importación de equipos directos de fábrica, arquitectura para Data Center, soporte técnico calificado y extensiones de garantía Lenovo."
>
  <!-- Header Banner -->
  <section class="relative bg-slate-950 text-white py-16 lg:py-20 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 z-0 opacity-25">
      <img
        src="/images/img/banners/header_serv.jpg"
        alt="Servicios EVS Tech"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-slate-950/80"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-bold text-red-500 uppercase tracking-widest bg-red-950/60 border border-red-800/60 px-3 py-1 rounded-full">
          Soluciones de Ingeniería y Soporte
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          Nuestros Servicios Corporativos
        </h1>
        <p class="text-base sm:text-lg text-slate-300">
          Acompañamos a nuestros clientes e integradores en todo el ciclo de vida tecnológico: desde la importación y provisión de hardware hasta el soporte post-venta y la cobertura oficial de garantías.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Detailed Cards -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      {
        SERVICES.map((serv, index) => {
          const isEven = index % 2 === 1;
          return (
            <div
              id={serv.id}
              class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center p-8 lg:p-12 rounded-3xl border border-slate-200/90 bg-slate-50 shadow-sm scroll-mt-28 ${
                isEven ? "lg:flex-row-reverse" : ""
              }`}
            >
              <!-- Icon & Image side -->
              <div class={`lg:col-span-5 ${isEven ? "lg:order-2" : "lg:order-1"}`}>
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-md space-y-6">
                  <div class="w-20 h-20 rounded-2xl bg-slate-50 border border-slate-200 p-3 flex items-center justify-center">
                    <img src={serv.iconImg} alt={serv.title} class="w-full h-full object-contain" />
                  </div>
                  <div>
                    <span class="text-xs font-bold text-red-600 uppercase tracking-wider">
                      Servicio 0{index + 1}
                    </span>
                    <h3 class="text-2xl font-black text-slate-900 mt-1">{serv.title}</h3>
                    <p class="text-xs text-slate-500 mt-1">{serv.shortDesc}</p>
                  </div>
                  <div class="pt-4 border-t border-slate-100">
                    <img
                      src="/images/img/servicios/img_serv.jpg"
                      alt="Operaciones y Soporte EVS Tech"
                      class="rounded-xl w-full h-44 object-cover"
                    />
                  </div>
                </div>
              </div>

              <!-- Content side -->
              <div class={`lg:col-span-7 space-y-6 ${isEven ? "lg:order-1" : "lg:order-2"}`}>
                <h2 class="text-2xl sm:text-3xl font-black text-slate-900 leading-tight">
                  {serv.title}
                </h2>
                <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
                  {serv.description}
                </p>

                <div class="space-y-3 pt-2">
                  <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">
                    Capacidades y Alcance:
                  </h4>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {serv.features.map((feat) => (
                      <div class="flex items-start gap-2 bg-white p-3.5 rounded-xl border border-slate-200/70 text-xs text-slate-700">
                        <span class="text-red-600 font-bold text-sm">✓</span>
                        <span class="leading-snug">{feat}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="pt-4 flex flex-wrap gap-4">
                  <a
                    href="/contacto"
                    class="px-6 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs sm:text-sm shadow-md transition-all inline-flex items-center gap-1.5"
                  >
                    <span>Consultar Disponibilidad</span>
                    <span>→</span>
                  </a>
                  <a
                    href={`mailto:${SITE.email}`}
                    class="px-6 py-2.5 rounded-lg bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-xs sm:text-sm transition-all"
                  >
                    Escribir a Ingeniería
                  </a>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</Layout>
