---
import { SITE, NAV_LINKS } from "../data/site";
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-300 border-t border-slate-800">
  <!-- Top CTA Strip -->
  <div class="bg-gradient-to-r from-red-600 to-red-800 text-white py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-2xl sm:text-3xl font-black tracking-tight">¿Listo para impulsar la infraestructura TI de su empresa?</h3>
        <p class="text-red-100 text-sm sm:text-base mt-1">Afíliese a nuestra red de distribución mayorista o solicite una cotización formal de equipos Lenovo.</p>
      </div>
      <div class="flex items-center gap-3 flex-wrap">
        <a
          href="/contacto"
          class="px-6 py-3 rounded-lg bg-white text-slate-900 font-bold hover:bg-slate-100 transition-colors shadow-lg"
        >
          Contactar Especialista
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="px-6 py-3 rounded-lg bg-red-900/60 border border-white/20 text-white font-bold hover:bg-red-900 transition-colors"
        >
          {SITE.email}
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Col 1: Brand Info -->
      <div class="space-y-4">
        <div class="bg-white p-2.5 rounded-lg inline-block">
          <img src="/logo.jpg" alt="EVS Tech" width="160" height="54" class="h-10 w-auto object-contain" />
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          Especialistas en soluciones integrales de tecnología de la información. Mayorista autorizado Lenovo en Venezuela desde 2014 con más de 10 años abasteciendo al mercado corporativo nacional.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900 border border-slate-800 text-xs font-semibold text-slate-300">
          <span class="w-2 h-2 rounded-full bg-red-500"></span>
          Canal Directo Lenovo Mayorista
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-red-500 pl-2.5">
          Navegación
        </h4>
        <ul class="space-y-2.5 text-sm">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition-colors flex items-center gap-1.5">
                  <span class="text-red-500">›</span> {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Soluciones de Hardware -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-red-500 pl-2.5">
          Equipamiento y Servicios
        </h4>
        <ul class="space-y-2.5 text-sm text-slate-400">
          <li><a href="/productos#laptops" class="hover:text-white transition-colors">Laptops Corporativas ThinkPad</a></li>
          <li><a href="/productos#desktops" class="hover:text-white transition-colors">Desktops & Tiny ThinkCentre</a></li>
          <li><a href="/productos#datacenter" class="hover:text-white transition-colors">Servidores ThinkSystem & Storage</a></li>
          <li><a href="/servicios#logistica-importacion" class="hover:text-white transition-colors">Logística de Importación Directa</a></li>
          <li><a href="/servicios#garantias" class="hover:text-white transition-colors">Care Packs & Extensiones de Garantía</a></li>
          <li><a href="/clientes" class="hover:text-white transition-colors">Red de Clientes y Distribuidores</a></li>
        </ul>
      </div>

      <!-- Col 4: Contacto Directo -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-red-500 pl-2.5">
          Atención al Cliente
        </h4>
        <div class="space-y-3 text-sm text-slate-400">
          <div>
            <span class="block text-xs font-bold uppercase text-slate-500">Teléfonos:</span>
            <div class="flex flex-col gap-1 mt-0.5">
              <a href={`tel:${SITE.phoneLink1}`} class="text-white hover:text-cyan-400 font-medium">0212-5240825</a>
              <a href={`tel:${SITE.phoneLink2}`} class="text-white hover:text-cyan-400 font-medium">0212-5240720</a>
            </div>
          </div>
          <div>
            <span class="block text-xs font-bold uppercase text-slate-500">Correo Electrónico:</span>
            <a href={`mailto:${SITE.email}`} class="text-white hover:text-cyan-400 font-medium break-all">{SITE.email}</a>
          </div>
          <div>
            <span class="block text-xs font-bold uppercase text-slate-500">Ubicación:</span>
            <p class="text-slate-300">Caracas, Venezuela</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom sub-footer -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} {SITE.legalName} • Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <a
          href={SITE.historicalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-400 hover:text-amber-400 transition-colors"
        >
          Versión Histórica (old.evstech.com.ve)
        </a>
        <span>•</span>
        <a href="/contacto" class="hover:text-slate-300">Soporte Técnico</a>
      </div>
    </div>
  </div>
</footer>
